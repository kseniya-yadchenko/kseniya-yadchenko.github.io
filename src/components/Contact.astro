---
import { type Lang } from '../i18n/types';
import { translator } from '../i18n';
import { EMAIL, SOCIALS, CV_URL } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);
---

<section id="contact">
  <div class="shead">
    <div class="mono">06</div>
    <div class="shrow"><h2 set:html={t('h2contact')} /></div>
  </div>
  <p class="bigname" set:html={t('sig3')} />
  <div class="lacerule"></div>
  <div class="contact">
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    {SOCIALS.map((social) => <a href={social.url}>{social.label}</a>)}
    <a href={CV_URL} set:html={t('cv')} />
  </div>
</section>
