---
import { getCollection } from 'astro:content';
import { type Lang } from '../i18n/types';
import { translator } from '../i18n';
import { SUBSTACK_URL, isExternal } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);

/**
 * Заметки приходят из двух мест: notes.yaml генерируется из макета
 * и перезаписывается, notes-extra.yaml ведётся руками.
 *
 * Записи без ссылки отбрасываются: в макете «Малая форма» была заполнена
 * рыбой с href="#", и такие заметки не должны попадать на живой сайт.
 * Фильтр общий, а не разовая чистка, — следующая версия макета может
 * снова принести заглушки.
 */
const fromMacro = await getCollection('notes');
const extra = await getCollection('notesExtra');

type Note = (typeof fromMacro)[number]['data'];
const byUrl = new Map<string, Note>();
for (const entry of [...fromMacro, ...extra]) byUrl.set(entry.data.url, entry.data);

const notes = [...byUrl.values()]
  .filter((note) => note.url !== '#')
  .sort((a, b) => (b.published ?? '').localeCompare(a.published ?? ''));
---

<section id="notes">
  <div class="shead">
    <div class="mono">02</div>
    <div class="shrow"><h2 set:html={t('h2notes')} /></div>
  </div>
  <div class="notes">
    {
      notes.map((note) => (
        <a
          class="note"
          href={note.url}
          target={isExternal(note.url) ? '_blank' : undefined}
          rel={isExternal(note.url) ? 'noopener' : undefined}
        >
          <span class="ndate">{note.date[lang]}</span>
          <span class="ntitle" set:html={note.title[lang]} />
          <span class="ndesc" set:html={note.dek[lang]} />
        </a>
      ))
    }
  </div>
  <a class="substack" href={SUBSTACK_URL} target="_blank" rel="noopener" set:html={t('substack')} />
</section>
