---
import { getCollection } from 'astro:content';
import { type Lang } from '../i18n/types';
import { translator } from '../i18n';
import { isExternal } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);

/**
 * Публикации приходят из двух мест: articles.yaml генерируется из макета
 * и перезаписывается, articles-extra.yaml ведётся руками. Дедупликация по url,
 * приоритет у ручного файла — он свежее по определению.
 */
const fromMacro = await getCollection('articles');
const extra = await getCollection('articlesExtra');

// Берём только data: у коллекций разные литеральные типы collection, и склеить
// сами записи без приведения нельзя, а компоненту ничего кроме data не нужно.
type Article = (typeof fromMacro)[number]['data'];
const byUrl = new Map<string, Article>();
for (const entry of [...fromMacro, ...extra]) byUrl.set(entry.data.url, entry.data);

const articles = [...byUrl.values()].sort((a, b) => b.year - a.year);
---

<section id="texts">
  <div class="shead">
    <div class="mono">01</div>
    <div class="shrow">
      <h2 set:html={t('h2texts')} />
    </div>
  </div>
  <div class="list">
    {
      articles.map((article) => (
        <a
          class="item"
          href={article.url}
          target={isExternal(article.url) ? '_blank' : undefined}
          rel={isExternal(article.url) ? 'noopener' : undefined}
        >
          <div class="imeta" set:html={article.meta[lang]} />
          <div>
            <span class="ititle" set:html={article.title[lang]} />
            <span class="idesc" set:html={article.dek[lang]} />
          </div>
        </a>
      ))
    }
  </div>
</section>
