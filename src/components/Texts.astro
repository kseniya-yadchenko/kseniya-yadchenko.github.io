---
import { getCollection } from 'astro:content';
import { type Lang } from '../i18n/types';
import { translator } from '../i18n';
import { isExternal } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);

const articles = (await getCollection('articles')).sort((a, b) => b.data.year - a.data.year);
---

<section id="texts">
  <div class="shead">
    <div class="mono">01</div>
    <div class="shrow">
      <h2 set:html={t('h2texts')} />
    </div>
  </div>
  <div class="list">
    {
      articles.map((article) => (
        <a
          class="item"
          href={article.data.url}
          target={isExternal(article.data.url) ? '_blank' : undefined}
          rel={isExternal(article.data.url) ? 'noopener' : undefined}
        >
          <div class="imeta" set:html={article.data.meta[lang]} />
          <div>
            <span class="ititle" set:html={article.data.title[lang]} />
            <span class="idesc" set:html={article.data.dek[lang]} />
          </div>
        </a>
      ))
    }
  </div>
</section>
