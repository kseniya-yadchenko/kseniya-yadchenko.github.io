---
import { type Lang } from '../i18n/types';
import { translator } from '../i18n';
import { TRANSLATION_SAMPLE_URL, isExternal } from '../data/site';
import { asset } from '../i18n/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translator(lang);

// Порядок как в макете: образец перевода стоит перед сроками.
const rows = [
  { key: 'p1', value: 'q1' },
  { key: 'p2', value: 'q2' },
  { key: 'p3', value: 'q3' },
  { key: 'p4', value: 'q4' },
] as const;
---

<section id="trans">
  <div class="shead">
    <div class="mono">05</div>
    <div class="shrow"><h2 set:html={t('h2trans')} /></div>
  </div>
  <div class="spec">
    {
      rows.map((row) => (
        <div class="specrow">
          <div class="speck" set:html={t(row.key)} />
          <div class="specv" set:html={t(row.value)} />
        </div>
      ))
    }
    <div class="specrow">
      <div class="speck" set:html={t('p6')} />
      <div class="specv">
        <a
          class="samplelink"
          href={asset(TRANSLATION_SAMPLE_URL)}
          target="_blank"
          rel={isExternal(TRANSLATION_SAMPLE_URL) ? 'noopener' : undefined}
          set:html={t('q6')}
        />
      </div>
    </div>
    <div class="specrow">
      <div class="speck" set:html={t('p5')} />
      <div class="specv" set:html={t('q5')} />
    </div>
  </div>
</section>
